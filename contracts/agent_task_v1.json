{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osiris.agiledefensesystems.com/contracts/agent_task_v1.json",
  "title": "OSIRIS Canonical Structured Agent & Department Task Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["proposal", "review", "refusal", "event"]
    },
    "department": {
      "type": "string",
      "enum": ["Research", "Engineering", "Security", "Governance"]
    },
    "agent": {
      "type": "string",
      "enum": ["AURA", "Aiden", "IRIS", "GovernanceRuntime"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "description", "parameters"],
        "properties": {
          "option_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["REFUSED", "COMPLETED", "NOT_EXECUTED", "BACKEND_REQUIRED", "NOT_AUTHORIZED"]
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "required_remediations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stream": {
      "type": "string",
      "enum": ["agent", "governance", "execution", "evidence"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
