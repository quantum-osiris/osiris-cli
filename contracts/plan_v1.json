{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://osiris.agiledefensesystems.com/contracts/plan_v1.json",
  "title": "OSIRIS Canonical Action Plan Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "meta", "authority", "steps", "validation"],
  "properties": {
    "plan_version": {
      "type": "string",
      "const": "1.0"
    },
    "execution_mode": {
      "type": "string",
      "enum": ["simulation", "hardware", "dry_run"]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "intent_id", "created_at", "planner_hash"],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "intent_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "planner_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "intent": { "type": "string", "maxLength": 4000 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "execution_level", "confirmed"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "execution_level": {
          "type": "string",
          "enum": ["read", "modify", "deploy"]
        },
        "confirmed": { "type": "boolean" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_allowed": { "type": "boolean" },
        "network_allowed": { "type": "boolean" },
        "quantum_domain": { "type": "string" },
        "crsm_axes_touched": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "edit_file",
              "create_file",
              "delete_file",
              "run_command",
              "apply_patch",
              "verify"
            ]
          },
          "description": { "type": "string" },
          "path": { "type": "string" },
          "diff": { "type": "string" },
          "command": { "type": "string" },
          "cwd": { "type": "string" },
          "target_engine": {
            "type": "string",
            "enum": ["dnalang-core", "qdecode", "osiris-cli", "organism_sim"]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preconditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "postconditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "annotations": {
      "type": "object"
    }
  }
}
