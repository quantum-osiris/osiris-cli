{
  "contract": "osiris-ide-api",
  "api_version": "1.0.0",
  "compatibility": "Clients must check api_version from GET /api/v1/meta and refuse a different MAJOR version. MINOR versions only add optional fields.",
  "transport": {
    "bind": "127.0.0.1 or ::1 only",
    "auth_header": "X-OSIRIS-Token",
    "host_check": "Host must equal the bound loopback address:port or localhost:port",
    "post_content_type": "application/json",
    "max_body_bytes": 262144,
    "github_writes": "not exposed; the API can only propose and dry-run"
  },
  "error": {
    "type": "object",
    "required": ["api_version", "error"],
    "properties": {
      "api_version": {"type": "string"},
      "error": {"type": "object", "required": ["kind", "message"],
                "properties": {"kind": {"type": "string"}, "message": {"type": "string"}}}
    }
  },
  "routes": {
    "GET /api/v1/meta": {
      "response": {"type": "object", "required": ["api_version", "service", "github_writes_via_api", "evidence_labels"],
        "properties": {"api_version": {"const": "1.0.0"}, "service": {"const": "osiris-ide-api"},
          "contract_sha256": {"type": ["string", "null"]}, "github_writes_via_api": {"const": false},
          "evidence_labels": {"type": "array", "items": {"type": "string"}}}}
    },
    "GET /api/v1/workspace": {
      "response": {"type": "object", "required": ["github", "repositories", "local"],
        "properties": {
          "github": {"type": "object", "required": ["authenticated", "login", "identity_matches"],
            "properties": {"authenticated": {"type": "boolean"}, "login": {"type": ["string", "null"]},
              "identity_matches": {"type": "boolean"}, "expected_login": {"type": "string"},
              "writes_enabled": {"type": "boolean"}, "security_gates": {"type": "object"}}},
          "repositories": {"type": "array", "items": {"type": "object", "required": ["repository", "ok"]}},
          "local": {"type": "array", "items": {"type": "object", "required": ["name", "present"]}}}}
    },
    "GET /api/v1/examples": {
      "response": {"type": "object", "required": ["examples"],
        "properties": {"examples": {"type": "array", "items": {"type": "object", "required": ["name", "source"],
          "properties": {"name": {"type": "string"}, "source": {"type": "string"}}}}}}
    },
    "POST /api/v1/dnalang/compile": {
      "request": {"type": "object", "required": ["source"], "properties": {"source": {"type": "string"}}},
      "response": {"type": "object", "required": ["ok", "source_sha256", "diagnostics"],
        "properties": {"ok": {"type": "boolean"}, "source_sha256": {"type": "string"},
          "diagnostics": {"type": "object", "required": ["errors", "warnings"],
            "properties": {"errors": {"type": "array", "items": {"type": "object", "required": ["stage", "message"]}},
              "warnings": {"type": "array"}}},
          "organism": {"type": "object"},
          "circuit": {"type": "object", "required": ["n_qubits", "n_cbits", "ops", "depth", "sha256", "qasm3"]}}}
    },
    "POST /api/v1/slice/run": {
      "request": {"type": "object", "required": ["source"],
        "properties": {"source": {"type": "string"}, "shots": {"type": "integer"}, "seed": {"type": "integer"}}},
      "response": {"type": "object", "required": ["schema", "run_id", "status", "evidence_class", "hardware", "stages", "compile"],
        "properties": {"schema": {"const": "osiris-slice-result/v1"}, "run_id": {"type": "string"},
          "status": {"enum": ["COMPLETED", "REJECTED", "FAILED"]}, "evidence_class": {"const": "SIMULATED"},
          "hardware": {"const": false},
          "stages": {"type": "array", "items": {"type": "object", "required": ["name", "status"],
            "properties": {"status": {"enum": ["OK", "FAILED"]}}}},
          "compile": {"type": "object"}, "admission": {"type": "object"},
          "simulation": {"type": "object", "required": ["counts", "label", "shots", "seed"]},
          "evaluation": {"type": "object", "required": ["shots", "exact_available", "claimed_metrics"]},
          "governance": {"type": "object", "required": ["all_matched", "epistemic_status", "evidence_class", "verification"]},
          "claim": {"type": "object", "required": ["category", "statement", "not_claimed"]},
          "receipt": {"type": "object", "required": ["hash", "prev", "chain_valid", "kind"]}}}
    },
    "POST /api/v1/organism/run": {
      "request": {"type": "object", "properties": {"ticks": {"type": "integer"}, "seed": {"type": "integer"},
        "burst_prob": {"type": "number"}}},
      "response": {"type": "object", "required": ["evidence_class", "engine", "summary", "series"],
        "properties": {"evidence_class": {"const": "SIMULATED"},
          "summary": {"type": "object", "required": ["status", "audit_chain_valid", "repairs", "mutations"]},
          "series": {"type": "array", "items": {"type": "object", "required": ["tick", "coherence"]}}}}
    },
    "GET /api/v1/governance/receipts": {
      "response": {"type": "object", "required": ["slice", "github"],
        "properties": {"slice": {"type": "object", "required": ["chain_valid", "count", "rows"]},
          "github": {"type": "object", "required": ["count", "rows"]}}}
    },
    "POST /api/v1/governance/github/propose": {
      "request": {"type": "object", "required": ["op"], "properties": {"op": {"type": "string"},
        "repo": {"type": ["string", "null"]}, "args": {"type": "object"}}},
      "response": {"type": "object", "required": ["proposal", "decision", "is_write"],
        "properties": {"proposal": {"type": "object", "required": ["capability", "fixture_id", "arguments", "nonce"]},
          "decision": {"type": "object", "required": ["decision", "reasons", "proposal_sha256", "decision_sha256", "requires_grant"],
            "properties": {"decision": {"enum": ["ALLOW", "DENY"]}}},
          "is_write": {"type": "boolean"},
          "dry_run": {"type": "object", "required": ["status"]}}}
    },
    "GET /api/v1/research/claims": {
      "response": {"type": "object", "required": ["source", "count", "claims"],
        "properties": {"claims": {"type": "array", "items": {"type": "object", "required": ["id", "statement", "standing"]}}}}
    },
    "GET /api/v1/research/experiments": {
      "response": {"type": "object", "required": ["chain_valid", "runs"],
        "properties": {"runs": {"type": "array", "items": {"type": "object", "required": ["run_id", "kind", "hash"]}}}}
    }
  }
}
